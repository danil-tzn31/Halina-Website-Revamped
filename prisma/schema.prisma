// Halina Travel — database schema
// Set DATABASE_URL in .env.local (Neon/Supabase Postgres), then run:
//   npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  // No signup flow sets this to true — promote a user to admin by hand
  // in Prisma Studio.
  isAdmin      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  bookings     Booking[]
  trips        Trip[]
}

enum BookingType {
  FLIGHT
  HOTEL
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
}

// One table for both flight and hotel bookings (the old app used separate
// FLIGHTS_BOOKINGS/HOTELS_BOOKINGS tables). `type` distinguishes the kind,
// `details` holds the type-specific fields (flight number, departure time, etc).
model Booking {
  id              String        @id @default(cuid())
  user            User          @relation(fields: [userId], references: [id])
  userId          String
  type            BookingType
  status          BookingStatus @default(PENDING)
  name            String // e.g. hotel name, or "MNL -> CEB"
  price           Decimal
  currency        String        @default("USD")
  dateFrom        DateTime
  dateTo          DateTime
  guests          Int           @default(1)
  details         Json? // flight number/departure time, or hotel-specific extras
  stripeSessionId String?
  // Optional so bookings made before trips existed (and hotels booked on
  // their own) still work. SetNull keeps the booking if its trip is ever
  // removed.
  trip            Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  tripId          String?
  createdAt       DateTime      @default(now())
}

// Groups the bookings that belong to one journey — a flight plus the hotel
// booked for it. Every flight booking starts a trip; a hotel joins one when
// it's booked from that trip's "find a place to stay" link.
model Trip {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  destination String // arrival airport code, e.g. "CEB"
  startDate   DateTime
  endDate     DateTime // same as startDate for a one-way flight
  createdAt   DateTime  @default(now())
  bookings    Booking[]
}
