# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored — never commit real secrets.
#
# Quirk: Next.js reads .env.local automatically, but the Prisma CLI
# (migrate dev, generate, studio) only reads a file literally named .env.
# So DATABASE_URL needs to exist in both files — both are covered by
# .gitignore's `.env*` pattern.

# --- Database ---
# From Neon or Supabase: Project settings -> Connection string (use the
# "pooled" connection string if Neon offers one).
# Needs to be in .env.local (for the app) AND .env (for the Prisma CLI) —
# see the note above.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth ---
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# --- External travel APIs ---
# Generate a fresh key on RapidAPI before using this. Never reference it
# directly in client-side code; it's only read inside app/api/*/route.ts.
RAPIDAPI_GOOGLE_FLIGHTS_KEY=""
# Hotel provider — see the HotelProvider adapter in lib/hotels/.
HOTEL_API_KEY=""
HOTEL_API_HOST=""

# --- Payments ---
# From the Stripe Dashboard, in TEST MODE (toggle in the left sidebar):
# Developers -> API keys for the secret key below. Checkout here is a
# server-created, hosted-redirect session (no Stripe.js/Elements on the
# client), so STRIPE_PUBLISHABLE_KEY isn't actually read by any code in
# this app — safe to leave blank.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Stripe can't reach your laptop directly for webhooks. For local dev, run
# the Stripe CLI (`stripe listen --forward-to localhost:3000/api/stripe/webhook`)
# and paste the "whsec_..." value it prints here — it differs from the
# live webhook secret, but stays valid across restarts of `stripe listen`
# on the same machine.
STRIPE_WEBHOOK_SECRET=""

# --- AI trip search ---
# A free Gemini API key, no credit card needed — get one at
# https://aistudio.google.com/apikey.
GEMINI_API_KEY=""
