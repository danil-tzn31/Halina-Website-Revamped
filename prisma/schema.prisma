// Halina Travel — database schema
// Set DATABASE_URL in .env.local (Neon/Supabase Postgres), then run:
//   npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  // No signup flow sets this to true — promote a user to admin by hand
  // in Prisma Studio.
  isAdmin      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  bookings     Booking[]
}

enum BookingType {
  FLIGHT
  HOTEL
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
}

// One table for both flight and hotel bookings (the old app used separate
// FLIGHTS_BOOKINGS/HOTELS_BOOKINGS tables). `type` distinguishes the kind,
// `details` holds the type-specific fields (flight number, departure time, etc).
model Booking {
  id              String        @id @default(cuid())
  user            User          @relation(fields: [userId], references: [id])
  userId          String
  type            BookingType
  status          BookingStatus @default(PENDING)
  name            String // e.g. hotel name, or "MNL -> CEB"
  price           Decimal
  currency        String        @default("USD")
  dateFrom        DateTime
  dateTo          DateTime
  guests          Int           @default(1)
  details         Json? // flight number/departure time, or hotel-specific extras
  stripeSessionId String?
  createdAt       DateTime      @default(now())
}
