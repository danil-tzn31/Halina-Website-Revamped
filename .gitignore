# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env* also matches .env.example by pattern, so explicitly
# un-ignore that one: it's a template with no real secrets (every value is
# blank), meant to be committed so anyone cloning the repo knows which
# variables to set. Without the line below, .env.example silently never
# gets pushed at all — which is exactly what happened here originally.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
