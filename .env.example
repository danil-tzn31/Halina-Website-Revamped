# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored — never commit real secrets.
#
# One quirk worth knowing: Next.js (npm run dev / npm run build) reads
# .env.local automatically, but the separate Prisma CLI (npx prisma migrate
# dev, npx prisma generate, npx prisma studio) only auto-reads a file
# literally named .env — it never looks at .env.local. So DATABASE_URL
# specifically needs to exist in BOTH files: copy this file to .env.local
# for the app, AND create a plain .env containing just the DATABASE_URL line
# for the Prisma CLI commands to work. Both filenames are already covered by
# .gitignore's `.env*` pattern, so this doesn't add any new secret-leak risk
# — it's just an extra copy-paste, not a security step.

# --- Database (Day 1) ---
# From Neon or Supabase: Project settings -> Connection string (use the
# "pooled" connection string if Neon offers one).
# Needs to be in .env.local (for the app) AND .env (for the Prisma CLI) —
# see the note above.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth (Day 2) ---
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# --- External travel APIs (Day 3-4) ---
# Rotate these on RapidAPI before using them here — see the revamp plan's
# "Urgent" section. Never reference these directly in client-side code;
# they're only read inside app/api/*/route.ts server code.
RAPIDAPI_GOOGLE_FLIGHTS_KEY=""
RAPIDAPI_CURRENCY_KEY=""
# New hotel provider — fill in once you have it (see the HotelProvider
# adapter in lib/hotels/).
HOTEL_API_KEY=""
HOTEL_API_HOST=""

# --- Payments (Day 5) ---
# From the Stripe Dashboard, in TEST MODE (the toggle in the left sidebar):
# Developers -> API keys for the secret key below. Checkout here is a
# server-created, hosted-redirect session (no Stripe.js/Elements on the
# client), so STRIPE_PUBLISHABLE_KEY isn't actually read by any code in this
# app — safe to leave blank, kept only in case a future embedded payment
# form needs it.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Stripe can't reach your laptop directly for webhooks. For local dev, run
# the Stripe CLI (`stripe listen --forward-to localhost:3000/api/stripe/webhook`)
# and paste the "whsec_..." value it prints here — it's different from your
# live webhook endpoint's signing secret (see DEPLOY.md step 4), but per
# Stripe's own CLI docs it does NOT change between restarts of `stripe
# listen` on the same machine/account — paste it once and it keeps working
# every time you restart the command, including after a reboot.
STRIPE_WEBHOOK_SECRET=""

# --- AI trip search (section 39 onward) ---
# A free Gemini API key, no credit card needed — get one at
# https://aistudio.google.com/apikey.
GEMINI_API_KEY=""

# --- Live destination feed (planned, section 47's "Next step") ---
# A free Geoapify Places API key, no credit card needed — get one at
# https://myprojects.geoapify.com/. Currently only used by the small
# standalone trial in scripts/test-geoapify.mjs, before any real feature
# code exists.
GEOAPIFY_API_KEY=""
